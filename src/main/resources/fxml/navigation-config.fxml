<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.myprojects.kpok2.controller.NavigationConfigController"
      prefHeight="520.0" prefWidth="780.0" spacing="10">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <Label text="%navigation.config.title" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    
    <GridPane hgap="10" vgap="10">
        <padding>
            <Insets top="10" right="0" bottom="10" left="0"/>
        </padding>
        
        <!-- Catalog account row -->
        <Label text="%navigation.config.catalog.account" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <HBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="1">
            <ComboBox fx:id="catalogAccountComboBox" prefWidth="320.0"/>
            <Button fx:id="refreshCatalogButton" text="%navigation.config.catalog.refresh"
                    onAction="#onRefreshCatalogClick"/>
        </HBox>

        <!-- Catalog search row -->
        <Label text="%navigation.config.catalog.search" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="catalogSearchField" promptText="KROK 3 Psychiatry"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <!-- Catalog selection row -->
        <Label text="%navigation.config.catalog.quiz" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="quizCatalogComboBox" prefWidth="560.0" visibleRowCount="12"
                  GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label fx:id="catalogStatusLabel" wrapText="true"
               GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <!-- Quiz URL Row: remains editable as a manual fallback -->
        <Label text="%navigation.config.quiz.url" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="quizUrlField" prefWidth="420.0"
                   promptText="https://test.testcentr.org.ua/mod/quiz/view.php?id=173"
                   GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <!-- Max Threads Row -->
        <Label text="%navigation.config.max.threads" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <Spinner fx:id="maxThreadsSpinner" editable="true" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        
        <!-- Iteration Count Row -->
        <Label text="%navigation.config.iteration.count" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <Spinner fx:id="iterationCountSpinner" editable="true" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
        
        <!-- Session Reuse Row -->
        <Label text="%navigation.config.reuse.session" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <CheckBox fx:id="reuseSessionCheckbox" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
    </GridPane>
    
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="saveButton" text="%button.save" onAction="#onSaveClick"/>
        <Button fx:id="cancelButton" text="%button.cancel" onAction="#onCancelClick"/>
    </HBox>
</VBox>
